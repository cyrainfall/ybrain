# 复制为 .env 使用：cp .env.example .env && chmod 600 .env
# 真实 .env 不入 Git、不进备份；密钥同时登记在密码管理器（票据 13）。

# CI 推送到阿里云 ACR 的镜像地址，如 registry.cn-shenzhen.aliyuncs.com/<namespace>/ybrain:latest
YBRAIN_IMAGE=

# 服务器 Tailscale 网卡 IP（服务器上执行 `ip -4 addr show tailscale0` 获取）
YBRAIN_TAILSCALE_IP=

# Web 界面基本认证密码（必填；未设置时 opencode serve 启动会告警）
OPENCODE_SERVER_PASSWORD=

# 模型供应商密钥（票据 07：聊天 DeepSeek 主力 + Zen 应急；嵌入 SiliconFlow）
# 插件只在日志打印 configured=true/false，绝不打印密钥内容
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
ZEN_API_KEY=

# 捕获接口（票据 19）：vault/data 目录与三渠道独立令牌（可单独吊销）
# compose 已把 /opt/ybrain/vault、/opt/ybrain/data 挂进容器
YBRAIN_VAULT_DIR=/opt/ybrain/vault
YBRAIN_DATA_DIR=/opt/ybrain/data
CAPTURE_TOKEN_WEB=
CAPTURE_TOKEN_ANDROID=
CAPTURE_TOKEN_WEREAD=

# 提炼与周复盘（票据 24；都可留空用默认）
# 提炼模型：默认 deepseek/deepseek-v4-flash
YBRAIN_DISTILL_MODEL=
# 周复盘触发小时（服务器本地时区，默认 20 点，即周日晚 8 点）
YBRAIN_WEEKLY_REVIEW_HOUR=

# Git 备份（票据 25）：vault 的 Gitee 私有仓库 SSH 地址
# 留空则只做本地提交、不推送（提炼流程不受影响）
# 部署密钥见 deploy/README.md 第四节：宿主 /opt/ybrain/gitee_deploy_key（chmod 600），compose 只读挂载
YBRAIN_VAULT_REMOTE=git@gitee.com:<your-account>/ybrain-vault.git
